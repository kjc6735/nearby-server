# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_ROTATE="15m"
JWT_REFRESH_ROTATE="7d"

SALT_OR_ROUND=10

# 로그 레벨: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"
# true면 pino-pretty로 사람이 읽기 좋게 출력 (개발용). 벤치마크·운영에서는 false.
LOG_PRETTY="false"
# true면 Prisma가 실행한 SQL과 실행 시간을 로그로 남긴다. 벤치마크 측정 시에는 false.
PRISMA_QUERY_LOG="false"
