// use prisma-next

enum TripPostStatus {
  open = "OPEN"
  closed = "CLOSED"
  cancelled = "CANCELLED"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  password  String?
  tripPost  TripPost[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  participations Participation[]
}

model Category {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  name         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
  deletedAt    TimestamptzString?

  tripPosts    TripPostCategory[]
}

model TripPostCategory {
  tripPostId Int
  tripPost   TripPost @relation(fields: [tripPostId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([tripPostId, categoryId])
}

model TripPost {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  placeName String?
  capacity  Int
  status    TripPostStatus  @default(open)
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  deletedAt TimestamptzString?
  meetAt    TimestamptzString
  lat       Float
  lng       Float
  participations Participation[]
  categories     TripPostCategory[]
}

model Participation {
  id        Int      @id @default(autoincrement())
  tripPostId Int
  tripPost TripPost @relation(fields: [tripPostId], references: [id])

  userId Int
  user User @relation(fields: [userId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString() 

  @@unique([tripPostId, userId])
  @@index([userId])
}

model ChatRoom {
  id         Int      @id @default(autoincrement())
  tripPostId Int      @unique
  tripPost   TripPost @relation(fields: [tripPostId], references: [id], onDelete: Cascade)
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
}


